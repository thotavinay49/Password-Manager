# =====================================================
# Backend Environment Variables
# Copy this file to .env for local development
# Set these in Railway Variables panel for production
# =====================================================

# Database — Railway MySQL plugin sets DB_URL, DB_USERNAME, DB_PASSWORD automatically
DB_URL=jdbc:mysql://localhost:3306/passwordmanagerdb?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=passwordmanager
DB_PASSWORD=your-strong-password-here
DB_ROOT_PASSWORD=your-root-password-here

# AES-256 encryption key for stored passwords (Base64-encoded, MUST be 32 bytes = 44 base64 chars)
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY==

# JWT signing secret (any long random string, min 32 chars)
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# CORS — comma-separated list of your frontend URLs (no trailing slashes)
# For local dev: http://localhost:5173
# For production: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true in production (HTTPS enforced by Railway)
COOKIE_SECURE=false
